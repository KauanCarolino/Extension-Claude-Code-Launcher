# Dependências
node_modules/

# Saída da compilação (gerada por `npm run compile`)
out/
*.map

# Pacotes gerados pelo vsce
*.vsix

# Pasta local do Claude Code: configurações da máquina, log de mudanças e skills instaladas
.claude/

# Logs
*.log
npm-debug.log*

# Arquivos do sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Documentação local de planejamento (PRDs e specs); só a verificação e a referência são publicadas
/docs/*
!/docs/VERIFICACAO.md
!/docs/REFERENCIA.md
!/docs/images/
