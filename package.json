{
  "name": "launcher-for-claude-code",
  "displayName": "Launcher for Claude Code",
  "description": "%extension.description%",
  "version": "1.3.0",
  "publisher": "KauanDeveloper",
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "claude",
    "claude code",
    "launcher",
    "revisão de mudanças",
    "diff",
    "code review",
    "review",
    "changes",
    "accept",
    "reject"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KauanCarolino/Extension-Claude-Code-Launcher.git"
  },
  "homepage": "https://github.com/KauanCarolino/Extension-Claude-Code-Launcher#readme",
  "bugs": {
    "url": "https://github.com/KauanCarolino/Extension-Claude-Code-Launcher/issues"
  },
  "galleryBanner": {
    "color": "#2b1d17",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0",
    "node": ">=22"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces%"
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.virtualWorkspaces%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "claude-code-launcher.openSidebar",
        "title": "%command.openSidebar%",
        "category": "Launcher for Claude Code",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "claude-code-launcher.openTab",
        "title": "%command.openTab%",
        "category": "Launcher for Claude Code",
        "icon": "$(open-preview)"
      },
      {
        "command": "claude-code-launcher.install",
        "title": "%command.install%",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.showChanges",
        "title": "%command.showChanges%",
        "category": "Launcher for Claude Code",
        "icon": "$(screen-full)"
      },
      {
        "command": "claude-code-launcher.enableChangeLog",
        "title": "%command.enableChangeLog%",
        "category": "Launcher for Claude Code",
        "icon": "$(record)"
      },
      {
        "command": "claude-code-launcher.disableChangeLog",
        "title": "%command.disableChangeLog%",
        "category": "Launcher for Claude Code",
        "icon": "$(debug-pause)"
      },
      {
        "command": "claude-code-launcher.clearChanges",
        "title": "%command.clearChanges%",
        "category": "Launcher for Claude Code",
        "icon": "$(trash)"
      },
      {
        "command": "claude-code-launcher.clearAllReviewData",
        "title": "%command.clearAllReviewData%",
        "category": "Launcher for Claude Code",
        "icon": "$(clear-all)"
      },
      {
        "command": "claude-code-launcher.releaseReviewWriter",
        "title": "%command.releaseReviewWriter%",
        "category": "Launcher for Claude Code",
        "icon": "$(unlock)"
      },
      {
        "command": "claude-code-launcher.recoverReviewWriter",
        "title": "%command.recoverReviewWriter%",
        "category": "Launcher for Claude Code",
        "icon": "$(lock)"
      },
      {
        "command": "claude-code-launcher.toggleInlineChanges",
        "title": "%command.toggleInlineChanges%",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.hideInlineChanges",
        "title": "%command.hideInlineChanges%",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.showInlineChanges",
        "title": "%command.showInlineChanges%",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.compareInline",
        "title": "%command.compareInline%",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.newTab",
        "title": "%command.newTab%",
        "category": "Launcher for Claude Code",
        "icon": "$(add)"
      },
      {
        "command": "claude-code-launcher.acceptAllChanges",
        "title": "%command.acceptAllChanges%",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.rejectAllChanges",
        "title": "%command.rejectAllChanges%",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.acceptEverything",
        "title": "%command.acceptEverything%",
        "category": "Launcher for Claude Code",
        "icon": "$(check-all)"
      },
      {
        "command": "claude-code-launcher.rejectEverything",
        "title": "%command.rejectEverything%",
        "category": "Launcher for Claude Code",
        "icon": "$(close-all)"
      },
      {
        "command": "claude-code-launcher.undoReject",
        "title": "%command.undoReject%",
        "category": "Launcher for Claude Code",
        "icon": "$(discard)"
      },
      {
        "command": "claude-code-launcher.nextChange",
        "title": "%command.nextChange%",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.previousChange",
        "title": "%command.previousChange%",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.acceptChange",
        "title": "%command.acceptChange%",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.rejectChange",
        "title": "%command.rejectChange%",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.refreshChanges",
        "title": "%command.refreshChanges%",
        "category": "Launcher for Claude Code",
        "icon": "$(refresh)"
      },
      {
        "command": "claude-code-launcher.refreshSessions",
        "title": "%command.refreshSessions%",
        "category": "Launcher for Claude Code",
        "icon": "$(refresh)"
      },
      {
        "command": "claude-code-launcher.skills.refresh",
        "title": "%command.skills.refresh%",
        "category": "Launcher for Claude Code",
        "icon": "$(refresh)"
      },
      {
        "command": "claude-code-launcher.showSkills",
        "title": "%command.showSkills%",
        "category": "Launcher for Claude Code",
        "icon": "$(sparkle)"
      },
      {
        "command": "claude-code-launcher.showChats",
        "title": "%command.showChats%",
        "category": "Launcher for Claude Code",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claude-code-launcher.showRules",
        "title": "%command.showRules%",
        "category": "Launcher for Claude Code",
        "icon": "$(law)"
      },
      {
        "command": "claude-code-launcher.showAgents",
        "title": "%command.showAgents%",
        "category": "Launcher for Claude Code",
        "icon": "$(hubot)"
      },
      {
        "command": "claude-code-launcher.showMcp",
        "title": "%command.showMcp%",
        "category": "Launcher for Claude Code",
        "icon": "$(plug)"
      },
      {
        "command": "claude-code-launcher.showPermissions",
        "title": "%command.showPermissions%",
        "category": "Launcher for Claude Code",
        "icon": "$(shield)"
      },
      {
        "command": "claude-code-launcher.showHooks",
        "title": "%command.showHooks%",
        "category": "Launcher for Claude Code",
        "icon": "$(zap)"
      },
      {
        "command": "claude-code-launcher.openWalkthrough",
        "title": "%command.openWalkthrough%",
        "category": "Launcher for Claude Code",
        "icon": "$(book)"
      },
      {
        "command": "claude-code-launcher.acceptChangeAtCursor",
        "title": "%command.acceptChangeAtCursor%",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.rejectChangeAtCursor",
        "title": "%command.rejectChangeAtCursor%",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.copyChangesSummary",
        "title": "%command.copyChangesSummary%",
        "category": "Launcher for Claude Code",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "claude-code-launcher.openSidebar",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "claude-code-launcher.newTab",
          "when": "view == claude-code-launcher.home",
          "group": "navigation@0"
        },
        {
          "command": "claude-code-launcher.refreshSessions",
          "when": "view == claude-code-launcher.home",
          "group": "navigation@1"
        },
        {
          "command": "claude-code-launcher.undoReject",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.canUndoReject",
          "group": "navigation@0"
        },
        {
          "command": "claude-code-launcher.refreshChanges",
          "when": "view == claude-code-launcher.changes",
          "group": "navigation@1"
        },
        {
          "command": "claude-code-launcher.showChanges",
          "when": "view == claude-code-launcher.changes",
          "group": "navigation@2"
        },
        {
          "command": "claude-code-launcher.acceptEverything",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.hasPendingChanges",
          "group": "1_review@1"
        },
        {
          "command": "claude-code-launcher.rejectEverything",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.hasPendingChanges",
          "group": "1_review@2"
        },
        {
          "command": "claude-code-launcher.toggleInlineChanges",
          "when": "view == claude-code-launcher.changes",
          "group": "2_view@1"
        },
        {
          "command": "claude-code-launcher.copyChangesSummary",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.hasChangeHistory",
          "group": "2_view@2"
        },
        {
          "command": "claude-code-launcher.enableChangeLog",
          "when": "view == claude-code-launcher.changes && !claudeCodeLauncher.changeLogEnabled",
          "group": "3_log@1"
        },
        {
          "command": "claude-code-launcher.disableChangeLog",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.changeLogEnabled",
          "group": "3_log@1"
        },
        {
          "command": "claude-code-launcher.clearChanges",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.hasChangeHistory",
          "group": "3_log@2"
        },
        {
          "command": "claude-code-launcher.recoverReviewWriter",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.reviewReadOnly",
          "group": "navigation@0"
        },
        {
          "command": "claude-code-launcher.releaseReviewWriter",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.reviewWriter",
          "group": "4_writer@1"
        },
        {
          "command": "claude-code-launcher.clearAllReviewData",
          "when": "view == claude-code-launcher.changes",
          "group": "3_log@3"
        },
        {
          "command": "claude-code-launcher.openWalkthrough",
          "when": "view == claude-code-launcher.home",
          "group": "9_help@1"
        }
      ],
      "commandPalette": [
        {
          "command": "claude-code-launcher.showInlineChanges",
          "when": "false"
        },
        {
          "command": "claude-code-launcher.compareInline",
          "when": "false"
        },
        {
          "command": "claude-code-launcher.acceptChange",
          "when": "false"
        },
        {
          "command": "claude-code-launcher.rejectChange",
          "when": "false"
        },
        {
          "command": "claude-code-launcher.refreshSessions",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "claude-code-launcher.nextChange",
        "key": "alt+]",
        "mac": "ctrl+alt+]",
        "when": "editorTextFocus && claudeCodeLauncher.hasPendingChanges && !inlineSuggestionVisible"
      },
      {
        "command": "claude-code-launcher.previousChange",
        "key": "alt+[",
        "mac": "ctrl+alt+[",
        "when": "editorTextFocus && claudeCodeLauncher.hasPendingChanges && !inlineSuggestionVisible"
      },
      {
        "command": "claude-code-launcher.acceptChangeAtCursor",
        "key": "alt+shift+y",
        "mac": "ctrl+alt+y",
        "when": "editorTextFocus && claudeCodeLauncher.hasPendingChanges && !inlineSuggestionVisible"
      },
      {
        "command": "claude-code-launcher.rejectChangeAtCursor",
        "key": "alt+shift+n",
        "mac": "ctrl+alt+n",
        "when": "editorTextFocus && claudeCodeLauncher.hasPendingChanges && !inlineSuggestionVisible"
      }
    ],
    "colors": [
      {
        "id": "claudeCodeLauncher.pendingChangeForeground",
        "description": "%color.pendingChangeForeground%",
        "defaults": {
          "dark": "#d98c5f",
          "light": "#b5592a",
          "highContrast": "#f0a070",
          "highContrastLight": "#9a4a20"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-code-launcher",
          "title": "Launcher for Claude Code",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claude-code-launcher": [
        {
          "type": "webview",
          "id": "claude-code-launcher.home",
          "name": "Launcher for Claude Code"
        },
        {
          "type": "webview",
          "id": "claude-code-launcher.changes",
          "name": "%view.changes%",
          "when": "!claudeCodeLauncher.panel || claudeCodeLauncher.panel == 'chats'"
        }
      ]
    },
    "configuration": {
      "title": "Launcher for Claude Code",
      "properties": {
        "claudeCodeLauncher.inlineChanges": {
          "type": "boolean",
          "default": true,
          "description": "%config.inlineChanges%"
        },
        "claudeCodeLauncher.captureCommandChanges": {
          "type": "boolean",
          "default": true,
          "description": "%config.captureCommandChanges%"
        },
        "claudeCodeLauncher.manageEditorGroups": {
          "type": "boolean",
          "default": false,
          "description": "%config.manageEditorGroups%"
        },
        "claudeCodeLauncher.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "%config.showStatusBarItem%"
        },
        "claudeCodeLauncher.hookExecutionMode": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "auto",
            "exec",
            "disabled"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.hookExecutionMode.auto%",
            "%config.hookExecutionMode.exec%",
            "%config.hookExecutionMode.disabled%"
          ],
          "description": "%config.hookExecutionMode%"
        },
        "claudeCodeLauncher.historyExcludedPatterns": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "default": [
            "**/.env",
            "**/.env.*",
            "**/*.pem",
            "**/*.key",
            "**/*.p12",
            "**/*.pfx",
            "**/id_rsa",
            "**/id_ed25519",
            "**/credentials.json"
          ],
          "description": "%config.historyExcludedPatterns%"
        },
        "claudeCodeLauncher.historyRetentionDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650,
          "default": 30,
          "description": "%config.historyRetentionDays%"
        },
        "claudeCodeLauncher.historyMaxStorageMB": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2048,
          "default": 128,
          "description": "%config.historyMaxStorageMB%"
        },
        "claudeCodeLauncher.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "pt-br"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.pt-br%"
          ],
          "description": "%config.language%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "install",
            "title": "%walkthrough.install.title%",
            "description": "%walkthrough.install.description%",
            "media": {
              "markdown": "%walkthrough.install.media%"
            },
            "completionEvents": [
              "onExtensionInstalled:anthropic.claude-code"
            ]
          },
          {
            "id": "openFolder",
            "title": "%walkthrough.openFolder.title%",
            "description": "%walkthrough.openFolder.description%",
            "media": {
              "markdown": "%walkthrough.openFolder.media%"
            },
            "completionEvents": [
              "onContext:workspaceFolderCount != 0"
            ]
          },
          {
            "id": "enableChangeLog",
            "title": "%walkthrough.enableChangeLog.title%",
            "description": "%walkthrough.enableChangeLog.description%",
            "media": {
              "markdown": "%walkthrough.enableChangeLog.media%"
            },
            "completionEvents": [
              "onContext:claudeCodeLauncher.changeLogEnabled"
            ]
          },
          {
            "id": "newChat",
            "title": "%walkthrough.newChat.title%",
            "description": "%walkthrough.newChat.description%",
            "media": {
              "markdown": "%walkthrough.newChat.media%"
            },
            "completionEvents": [
              "onCommand:claude-code-launcher.newTab"
            ]
          },
          {
            "id": "review",
            "title": "%walkthrough.review.title%",
            "description": "%walkthrough.review.description%",
            "media": {
              "markdown": "%walkthrough.review.media%"
            },
            "completionEvents": [
              "onCommand:claude-code-launcher.showChanges",
              "onView:claude-code-launcher.changes"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "node scripts/build.cjs",
    "typecheck": "tsc -p ./ --noEmit && tsc -p tsconfig.hooks.json && tsc -p tsconfig.webview.json",
    "lint": "eslint src hooks media",
    "watch": "node scripts/build.cjs --watch",
    "test": "npm run compile && node --test \"test/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "verify:package": "node scripts/verify-package.cjs",
    "test:package": "node --test test/package/*.test.cjs",
    "test:host": "node scripts/test-host.cjs",
    "test:host:contracts": "node scripts/test-host-contracts.cjs",
    "test:orchestrator": "npm --prefix orchestrator test"
  },
  "devDependencies": {
    "@types/node": "20.16.15",
    "@types/vscode": "1.94.0",
    "@vscode/codicons": "0.0.36",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.73.0",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.9"
    }
  }
}
