{
  "name": "launcher-for-claude-code",
  "displayName": "Launcher for Claude Code",
  "description": "Abre o chat oficial do Claude Code e mostra, de forma didática, o que ele mudou em cada arquivo. Extensão independente: não é um produto da Anthropic.",
  "version": "1.0.0",
  "publisher": "KauanDeveloper",
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "claude",
    "claude code",
    "launcher",
    "revisão de mudanças",
    "diff",
    "code review"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KauanCarolino/Extension-Claude-Code-Launcher.git"
  },
  "homepage": "https://github.com/KauanCarolino/Extension-Claude-Code-Launcher#readme",
  "bugs": {
    "url": "https://github.com/KauanCarolino/Extension-Claude-Code-Launcher/issues"
  },
  "galleryBanner": {
    "color": "#2b1d17",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0",
    "node": ">=22"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "A revisão pode restaurar arquivos e configurar hooks locais. Confie no workspace para habilitar o launcher."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "A revisão e o registro de mudanças exigem pastas no disco local. A abertura do chat depende do suporte da extensão oficial a esse tipo de workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "claude-code-launcher.openSidebar",
        "title": "Abrir chat na barra lateral",
        "category": "Launcher for Claude Code",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "claude-code-launcher.openTab",
        "title": "Abrir chat em nova aba",
        "category": "Launcher for Claude Code",
        "icon": "$(open-preview)"
      },
      {
        "command": "claude-code-launcher.install",
        "title": "Instalar Claude Code",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.showChanges",
        "title": "Mostrar mudanças do Claude",
        "category": "Launcher for Claude Code",
        "icon": "$(screen-full)"
      },
      {
        "command": "claude-code-launcher.enableChangeLog",
        "title": "Ativar registro de mudanças",
        "category": "Launcher for Claude Code",
        "icon": "$(record)"
      },
      {
        "command": "claude-code-launcher.disableChangeLog",
        "title": "Desligar registro de mudanças",
        "category": "Launcher for Claude Code",
        "icon": "$(debug-pause)"
      },
      {
        "command": "claude-code-launcher.clearChanges",
        "title": "Limpar histórico revisado",
        "category": "Launcher for Claude Code",
        "icon": "$(trash)"
      },
      {
        "command": "claude-code-launcher.clearAllReviewData",
        "title": "Apagar todos os dados locais de revisão",
        "category": "Launcher for Claude Code",
        "icon": "$(clear-all)"
      },
      {
        "command": "claude-code-launcher.releaseReviewWriter",
        "title": "Liberar revisão para outra janela",
        "category": "Launcher for Claude Code",
        "icon": "$(unlock)"
      },
      {
        "command": "claude-code-launcher.recoverReviewWriter",
        "title": "Recuperar revisão bloqueada",
        "category": "Launcher for Claude Code",
        "icon": "$(lock)"
      },
      {
        "command": "claude-code-launcher.toggleInlineChanges",
        "title": "Ligar/desligar marcas das mudanças no código",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.hideInlineChanges",
        "title": "Ocultar marcas (aceita as mudanças do Claude neste arquivo)",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.showInlineChanges",
        "title": "Ver mudança no código",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.compareInline",
        "title": "Comparar lado a lado",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.newTab",
        "title": "Nova conversa em aba",
        "category": "Launcher for Claude Code",
        "icon": "$(add)"
      },
      {
        "command": "claude-code-launcher.acceptAllChanges",
        "title": "Aceitar todas as mudanças do Claude neste arquivo",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.rejectAllChanges",
        "title": "Recusar todas as mudanças do Claude neste arquivo",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.acceptEverything",
        "title": "Aceitar todas as mudanças pendentes do Claude",
        "category": "Launcher for Claude Code",
        "icon": "$(check-all)"
      },
      {
        "command": "claude-code-launcher.rejectEverything",
        "title": "Recusar todas as mudanças pendentes do Claude",
        "category": "Launcher for Claude Code",
        "icon": "$(close-all)"
      },
      {
        "command": "claude-code-launcher.undoReject",
        "title": "Desfazer a última recusa",
        "category": "Launcher for Claude Code",
        "icon": "$(discard)"
      },
      {
        "command": "claude-code-launcher.nextChange",
        "title": "Próxima mudança do Claude",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.previousChange",
        "title": "Mudança anterior do Claude",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.acceptChange",
        "title": "Aceitar trecho",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.rejectChange",
        "title": "Recusar trecho",
        "category": "Launcher for Claude Code"
      },
      {
        "command": "claude-code-launcher.refreshChanges",
        "title": "Atualizar mudanças",
        "category": "Launcher for Claude Code",
        "icon": "$(refresh)"
      },
      {
        "command": "claude-code-launcher.refreshSessions",
        "title": "Atualizar conversas",
        "category": "Launcher for Claude Code",
        "icon": "$(refresh)"
      },
      {
        "command": "claude-code-launcher.skills.refresh",
        "title": "Atualizar skills",
        "category": "Launcher for Claude Code",
        "icon": "$(refresh)"
      },
      {
        "command": "claude-code-launcher.showSkills",
        "title": "Mostrar skills",
        "category": "Launcher for Claude Code",
        "icon": "$(sparkle)"
      },
      {
        "command": "claude-code-launcher.showChats",
        "title": "Mostrar conversas e mudanças",
        "category": "Launcher for Claude Code",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "claude-code-launcher.openSidebar",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "claude-code-launcher.newTab",
          "when": "view == claude-code-launcher.home",
          "group": "navigation@0"
        },
        {
          "command": "claude-code-launcher.refreshSessions",
          "when": "view == claude-code-launcher.home",
          "group": "navigation@1"
        },
        {
          "command": "claude-code-launcher.undoReject",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.canUndoReject",
          "group": "navigation@0"
        },
        {
          "command": "claude-code-launcher.refreshChanges",
          "when": "view == claude-code-launcher.changes",
          "group": "navigation@1"
        },
        {
          "command": "claude-code-launcher.showChanges",
          "when": "view == claude-code-launcher.changes",
          "group": "navigation@2"
        },
        {
          "command": "claude-code-launcher.acceptEverything",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.hasPendingChanges",
          "group": "1_review@1"
        },
        {
          "command": "claude-code-launcher.rejectEverything",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.hasPendingChanges",
          "group": "1_review@2"
        },
        {
          "command": "claude-code-launcher.toggleInlineChanges",
          "when": "view == claude-code-launcher.changes",
          "group": "2_view@1"
        },
        {
          "command": "claude-code-launcher.enableChangeLog",
          "when": "view == claude-code-launcher.changes && !claudeCodeLauncher.changeLogEnabled",
          "group": "3_log@1"
        },
        {
          "command": "claude-code-launcher.disableChangeLog",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.changeLogEnabled",
          "group": "3_log@1"
        },
        {
          "command": "claude-code-launcher.clearChanges",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.hasChangeHistory",
          "group": "3_log@2"
        },
        {
          "command": "claude-code-launcher.recoverReviewWriter",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.reviewReadOnly",
          "group": "navigation@0"
        },
        {
          "command": "claude-code-launcher.releaseReviewWriter",
          "when": "view == claude-code-launcher.changes && claudeCodeLauncher.reviewWriter",
          "group": "4_writer@1"
        },
        {
          "command": "claude-code-launcher.clearAllReviewData",
          "when": "view == claude-code-launcher.changes",
          "group": "3_log@3"
        }
      ],
      "commandPalette": [
        {
          "command": "claude-code-launcher.showInlineChanges",
          "when": "false"
        },
        {
          "command": "claude-code-launcher.compareInline",
          "when": "false"
        },
        {
          "command": "claude-code-launcher.acceptChange",
          "when": "false"
        },
        {
          "command": "claude-code-launcher.rejectChange",
          "when": "false"
        },
        {
          "command": "claude-code-launcher.refreshSessions",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "claude-code-launcher.nextChange",
        "key": "alt+]",
        "mac": "ctrl+alt+]",
        "when": "editorTextFocus && claudeCodeLauncher.hasPendingChanges && !inlineSuggestionVisible"
      },
      {
        "command": "claude-code-launcher.previousChange",
        "key": "alt+[",
        "mac": "ctrl+alt+[",
        "when": "editorTextFocus && claudeCodeLauncher.hasPendingChanges && !inlineSuggestionVisible"
      }
    ],
    "colors": [
      {
        "id": "claudeCodeLauncher.pendingChangeForeground",
        "description": "Cor dos arquivos com mudanças do Claude para revisar, no Explorer.",
        "defaults": {
          "dark": "#d98c5f",
          "light": "#b5592a",
          "highContrast": "#f0a070",
          "highContrastLight": "#9a4a20"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-code-launcher",
          "title": "Launcher for Claude Code",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claude-code-launcher": [
        {
          "type": "webview",
          "id": "claude-code-launcher.home",
          "name": "Launcher for Claude Code"
        },
        {
          "type": "webview",
          "id": "claude-code-launcher.changes",
          "name": "Mudanças",
          "when": "claudeCodeLauncher.panel != 'skills'"
        }
      ]
    },
    "configuration": {
      "title": "Launcher for Claude Code",
      "properties": {
        "claudeCodeLauncher.inlineChanges": {
          "type": "boolean",
          "default": true,
          "description": "Mostra a revisão das mudanças do Claude no editor, preservando decisões parciais e bloqueando ações quando houver conflito."
        },
        "claudeCodeLauncher.manageEditorGroups": {
          "type": "boolean",
          "default": false,
          "description": "Permite ao launcher organizar os grupos do chat e gerir suas preferências de abertura. Ao desligar, restaura somente valores que continuem iguais aos definidos pelo launcher."
        },
        "claudeCodeLauncher.hookExecutionMode": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "auto",
            "exec",
            "disabled"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Ativa hooks somente quando o Claude Code selecionado declara suporte a executável e argumentos separados.",
            "Usa executável e argumentos separados após você confirmar que sua versão do Claude Code suporta esse formato.",
            "Desativa a instalação e execução dos hooks geridos pelo launcher."
          ],
          "description": "Formato de execução do registro de mudanças. Versões sem suporte confirmado permanecem desativadas; não há alternativa automática via shell. Vale para a máquina: as configurações de um projeto não alteram esta opção."
        },
        "claudeCodeLauncher.historyExcludedPatterns": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "default": [
            "**/.env",
            "**/.env.*",
            "**/*.pem",
            "**/*.key",
            "**/*.p12",
            "**/*.pfx",
            "**/id_rsa",
            "**/id_ed25519",
            "**/credentials.json"
          ],
          "description": "Padrões de caminhos excluídos de novas cópias de conteúdo no histórico local. Os padrões definidos no projeto somam-se aos do usuário e não os substituem. Alterar a lista não apaga cópias já existentes."
        },
        "claudeCodeLauncher.historyRetentionDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650,
          "default": 30,
          "description": "Retenção do histórico já revisado, em dias. Zero desativa a limpeza por idade. Pendências e dados necessários à recuperação são preservados."
        },
        "claudeCodeLauncher.historyMaxStorageMB": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2048,
          "default": 128,
          "description": "Limite de armazenamento local do histórico em MiB. Ao atingir o limite, novas capturas são suspensas sem apagar revisões pendentes."
        }
      }
    }
  },
  "scripts": {
    "compile": "node scripts/build.cjs",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint src",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"test/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "verify:package": "node scripts/verify-package.cjs",
    "test:package": "node --test test/package/*.test.cjs",
    "test:host": "node scripts/test-host.cjs",
    "test:host:contracts": "node scripts/test-host-contracts.cjs"
  },
  "devDependencies": {
    "@types/node": "20.16.15",
    "@types/vscode": "1.94.0",
    "@vscode/codicons": "0.0.36",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "eslint": "10.15.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.73.0",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.9"
    }
  }
}
