{
  "name": "orquestra",
  "version": "0.0.1",
  "private": true,
  "description": "Local CLI that turns a request into a tested branch using Claude Code and Codex with each person's own login.",
  "license": "MIT",
  "bin": {
    "orquestra": "out/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../node_modules/typescript/bin/tsc -p .",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p . --noEmit",
    "test": "npm run build && node --test \"out/test/*.test.js\""
  }
}
