# Código-fonte e configs de build (o pacote usa só dist/, o bundle da extensão)
src/**
out/**
test/**
scripts/**
docs/**
.github/**
tsconfig.json
tsconfig.*.json
types/**
# Orquestrador: CLI separada, fora do pacote da extensão
orchestrator/**
.orquestra/**
eslint.config.mjs
**/*.ts
**/*.map

# Dependências de desenvolvimento
node_modules/**

# Configurações do editor, git e Claude
.vscode/**
.claude/**
.git/**
.gitignore
.gitattributes

# README e CHANGELOG em português: a página do Marketplace usa os em inglês, que apontam para eles
README.pt-BR.md
CHANGELOG.pt-BR.md

# Pacotes antigos e logs
**/*.vsix
**/*.log

# Arquivos do sistema operacional
**/.DS_Store
**/Thumbs.db
**/desktop.ini
